# NetWeave Docker Compose Environment Variables
#
# Copy this file to .env and customize values for your environment
# IMPORTANT: Never commit .env to git (contains sensitive data)

# Redis Password
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=changeme

# PostgreSQL Configuration
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
# Password is managed via Docker secret: secrets/postgres_password.txt

# Keycloak Configuration
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8443
# Admin password is managed via Docker secret: secrets/keycloak_admin_password.txt

# Vault Configuration
VAULT_ADDR=https://localhost:8200
VAULT_SKIP_VERIFY=true

# Network Configuration
COMPOSE_PROJECT_NAME=netweave
